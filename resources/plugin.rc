// Settings dialog template.
//
// Deliberately ASCII only: every user-visible string is set from C++ at WM_INITDIALOG,
// which is also what makes the German/English switch possible at all. The placeholders
// below are never shown.

#include <windows.h>
#include <commctrl.h>

#include "resource.h"

#pragma code_page(65001)

IDD_SETTINGS DIALOGEX 0, 0, 320, 264
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "TS3 SteelSeries OLED"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Display items", IDC_LABEL_WIDGETS, 7, 7, 220, 8
    CONTROL         "", IDC_WIDGETS, "SysListView32",
                    LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,
                    7, 18, 220, 112
    PUSHBUTTON      "Up", IDC_UP, 233, 18, 80, 14
    PUSHBUTTON      "Down", IDC_DOWN, 233, 36, 80, 14

    LTEXT           "Duration", IDC_LABEL_DURATION, 233, 58, 80, 8
    EDITTEXT        IDC_DURATION, 233, 69, 32, 14, ES_NUMBER | ES_RIGHT | WS_TABSTOP
    PUSHBUTTON      "Apply", IDC_DURATION_APPLY, 269, 69, 44, 14

    LTEXT           "Language", IDC_LABEL_LANGUAGE, 233, 92, 80, 8
    COMBOBOX        IDC_LANGUAGE, 233, 103, 80, 80,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Thresholds", IDC_LABEL_THRESHOLDS, 7, 136, 220, 8
    LTEXT           "Ping", IDC_LABEL_PING, 7, 150, 55, 8
    EDITTEXT        IDC_PING, 64, 147, 34, 14, ES_NUMBER | ES_RIGHT | WS_TABSTOP
    LTEXT           "Loss", IDC_LABEL_LOSS, 112, 150, 45, 8
    EDITTEXT        IDC_PACKET_LOSS, 159, 147, 34, 14, ES_RIGHT | WS_TABSTOP

    LTEXT           "Buddies", IDC_LABEL_BUDDIES, 7, 172, 220, 8
    LISTBOX         IDC_BUDDIES, 7, 183, 220, 42,
                    LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    EDITTEXT        IDC_BUDDY_UID, 7, 229, 220, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Add", IDC_BUDDY_ADD, 233, 229, 80, 14
    PUSHBUTTON      "Remove", IDC_BUDDY_REMOVE, 233, 183, 80, 14

    LTEXT           "", IDC_STATUS, 7, 249, 195, 8
    DEFPUSHBUTTON   "OK", IDOK, 207, 246, 50, 14
    PUSHBUTTON      "Close", IDCANCEL, 263, 246, 50, 14
END
